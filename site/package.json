{
  "name": "kuronuri-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "deploy": "rm -rf .vercel/output && NITRO_PRESET=vercel pnpm build && npx vercel deploy --prebuilt --archive=tgz",
    "deploy:prod": "rm -rf .vercel/output && NITRO_PRESET=vercel pnpm build && npx vercel deploy --prebuilt --archive=tgz --prod",
    "format": "oxfmt",
    "lint": "oxlint --deny-warnings",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/plausible": "^4.0.0",
    "@nuxtjs/seo": "^6.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.47",
    "kuronuri": "workspace:*",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  }
}
