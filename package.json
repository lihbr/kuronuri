{
  "name": "kuronuri",
  "version": "0.0.0",
  "description": "redaction, with japanese support, and more",
  "keywords": [
    "font",
    "japanese",
    "lihbr",
    "pixel",
    "redaction",
    "woff2"
  ],
  "homepage": "https://kuronuri.lihbr.com",
  "license": "OFL-1.1",
  "author": "lihbr <mail@lihbr.com> (https://lihbr.com)",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lihbr/kuronuri.git"
  },
  "files": [
    "dist/web",
    "OFL.txt"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/web/index.css",
    "./*.css": "./dist/web/*.css",
    "./files/*": "./dist/web/files/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "venv": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt && sh src/fetch_sources.sh",
    "review": ".venv/bin/python src/review.py",
    "build": ".venv/bin/python src/build.py",
    "dev": "pnpm -C site dev",
    "format": ".venv/bin/ruff format && pnpm -C site format",
    "lint": ".venv/bin/ruff check && pnpm -C site lint",
    "unit": ".venv/bin/python test/check.py",
    "release": "pnpm lint && bumpp",
    "release:dry": "npx changelogithub --dry"
  },
  "devDependencies": {
    "bumpp": "^12.3.0"
  },
  "packageManager": "pnpm@12.6.0"
}
